#!/bin/bash

# 1. Ensure Rofi can locate system utilities by explicitly adding common paths
export PATH="$HOME/.local/bin:$PATH"

# Explicit paths to your actual files
VENV_DIR="$HOME/Workspace/projects/YTDownload/.venv"
SCRIPT_DIR="$HOME/.config/hypr/scripts"

# 2. Get URL from Rofi input
URL=$(rofi -dmenu -p "Paste YouTube URL")

if [ -z "$URL" ]; then
    exit 1
fi

# 3. Get the list of formats using the exact yt-dlp binary from your project workspace
CHOICE=$("$VENV_DIR"/bin/yt-dlp -j "$URL" | jq -r '.formats[] | select(.vcodec != "none" and .height != null) | "\(.format_id) | \(.height)p | \(.ext) | \(.vcodec)"' | rofi -dmenu -i -p "Select Resolution")

if [ -z "$CHOICE" ]; then
    exit 1
fi

# 4. Extract the ID (the first part before the '|')
ID=$(echo "$CHOICE" | cut -d' ' -f1)

# 5. Launch Kitty using the project virtual environment's python to execute your script
kitty --class="ytdl-float" -e "$VENV_DIR"/bin/python "$SCRIPT_DIR"/ytdl.py "$URL" "$ID"
